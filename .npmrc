# Security hardening for npm
# Use exact versions from lockfile
package-lock=true
# Strict engine requirements
engine-strict=true
# Enable provenance attestation for published packages
provenance=true
# Audit before install
audit=true
# Require signed packages where available
verify-signatures=true
# Set to registry URL for integrity verification
registry=https://registry.npmjs.org/
# Prefer npm ci for reproducible installs in CI environments
prefer-offline=true
