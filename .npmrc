# Security hardening for npm
# Prevent running scripts automatically during install
ignore-scripts=true
# Use exact versions from lockfile
package-lock=true
# Strict engine requirements
engine-strict=true
# Don't write package-lock for nested packages (use workspace root)
package-lock-only=true
# Enable provenance attestation for published packages
provenance=true
# Set to registry URL for integrity verification
registry=https://registry.npmjs.org/
