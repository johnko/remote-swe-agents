{
  "name": "remote-swe-agents",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,mts}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,mts}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "zod": "^4.6.6"
  }
}
