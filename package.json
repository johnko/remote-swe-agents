{
  "name": "remote-swe-agents",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,mts}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,mts}\"",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "patch-package": "8.0.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "katex": "0.16.47",
    "picomatch": "4.0.7",
    "minimatch": "5.1.6",
    "micromatch": "4.0.8"
  }
}
