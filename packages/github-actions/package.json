{
  "name": "github-actions",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "npx tsx src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@actions/core": "2.0.3",
    "@actions/github": "9.1.1",
    "@octokit/rest": "22.0.1",
    "@remote-swe-agents/agent-core": "file:../agent-core",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
