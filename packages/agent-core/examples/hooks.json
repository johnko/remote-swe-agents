{
  "hooks": [
    {
      "name": "log-tool-usage",
      "description": "Log all tool executions for audit purposes",
      "event": ["toolBefore", "toolAfter"],
      "type": "command",
      "command": "bash ./packages/agent-core/examples/hooks/log-tool-usage.sh",
      "blocking": false,
      "timeout": 5000,
      "enabled": true
    },
    {
      "name": "block-dangerous-commands",
      "description": "Block dangerous shell patterns for security",
      "event": "toolBefore",
      "type": "command",
      "command": "bash ./packages/agent-core/examples/hooks/block-dangerous-commands.sh",
      "blocking": true,
      "timeout": 3000,
      "enabled": true
    },
    {
      "name": "session-audit",
      "description": "Audit session lifecycle events (start/end)",
      "event": ["sessionStart", "sessionEnd"],
      "type": "command",
      "command": "bash ./packages/agent-core/examples/hooks/session-audit.sh",
      "blocking": false,
      "timeout": 5000,
      "enabled": true
    }
  ]
}
