{
  "name": "worker",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write './**/*.ts'",
    "format:check": "prettier --check './**/*.ts'",
    "test": "vitest run --passWithNoTests",
    "setup:local": "docker compose up -d && npx tsx --env-file=.env.local scripts/setup-dynamodb-local.ts",
    "start:local": "tsx --env-file=.env.local src/local.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@strands-agents/sdk": "1.13.0",
    "@aws-sdk/client-bedrock-runtime": "3.1165.0",
    "@aws-sdk/client-dynamodb": "3.1165.0",
    "@aws-sdk/client-ec2": "3.1165.0",
    "@aws-sdk/client-s3": "3.1165.0",
    "@aws-sdk/client-sts": "3.1165.0",
    "@aws-sdk/credential-providers": "3.1165.0",
    "@aws-sdk/lib-dynamodb": "3.1165.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@remote-swe-agents/agent-core": "file:../agent-core",
    "@slack/bolt": "4.7.3",
    "aws-amplify": "6.22.2",
    "express": "5.3.0",
    "p-retry": "6.2.1",
    "playwright": "1.65.0",
    "sharp": "0.35.5",
    "ws": "8.22.2",
    "zod": "4.6.7"
  }
}
