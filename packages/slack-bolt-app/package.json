{
  "name": "slack-bolt-app",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "build": "tsc",
    "bundle": "esbuild src/lambda.ts src/async-handler.ts src/local.ts --bundle --outdir=dist --platform=node --charset=utf8 --external:@node-rs/*",
    "bundle:validate": "npm run bundle && npm run validate:bundle",
    "validate:bundle": "node --eval \"const fs = require('fs'); const code = fs.readFileSync('./dist/lambda.js', 'utf8'); if (!code.includes('export') || !code.includes('handler')) { console.error('✗ Missing handler export'); process.exit(1); } console.log('✓ Lambda bundle valid'); console.log('✓ Handler export found');\"",
    "format": "prettier --write './**/*.ts'",
    "format:check": "prettier --check './**/*.ts'",
    "test": "echo \\\"Error: no test specified\\\" && exit 1"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-lambda-powertools/idempotency": "^2.14.0",
    "@aws-sdk/client-bedrock-runtime": "^3.751.0",
    "@aws-sdk/client-dynamodb": "^3.744.0",
    "@aws-sdk/client-ec2": "^3.743.0",
    "@aws-sdk/client-lambda": "^3.744.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/client-ssm": "^3.787.0",
    "@aws-sdk/credential-provider-node": "^3.750.0",
    "@aws-sdk/lib-dynamodb": "^3.751.0",
    "@remote-swe-agents/agent-core": "file:../agent-core",
    "@slack/bolt": "^4.0.0",
    "@slack/web-api": "^7.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.8.6",
    "esbuild": "^0.28.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
