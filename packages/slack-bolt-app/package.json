{
  "name": "slack-bolt-app",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "build": "tsc",
    "bundle": "esbuild src/lambda.ts src/async-handler.ts src/local.ts --bundle --outdir=dist --platform=node --charset=utf8 --external:@node-rs/*",
    "bundle:validate": "npm run bundle && npm run validate:bundle",
    "validate:bundle": "node --eval \"const fs = require('fs'); const code = fs.readFileSync('./dist/lambda.js', 'utf8'); if (!code.includes('export') || !code.includes('handler')) { console.error('✗ Missing handler export'); process.exit(1); } console.log('✓ Lambda bundle valid'); console.log('✓ Handler export found');\"",
    "format": "prettier --write './**/*.ts'",
    "format:check": "prettier --check './**/*.ts'",
    "test": "echo \\\"Error: no test specified\\\" && exit 1"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-lambda-powertools/idempotency": "2.36.0",
    "@aws-sdk/client-bedrock-runtime": "3.1165.0",
    "@aws-sdk/client-dynamodb": "3.1165.0",
    "@aws-sdk/client-ec2": "3.1165.0",
    "@aws-sdk/client-lambda": "3.1165.0",
    "@aws-sdk/client-s3": "3.1165.0",
    "@aws-sdk/client-ssm": "3.1165.0",
    "@aws-sdk/credential-provider-node": "3.972.95",
    "@aws-sdk/lib-dynamodb": "3.1165.0",
    "@remote-swe-agents/agent-core": "file:../agent-core",
    "@slack/bolt": "4.7.3",
    "@slack/web-api": "7.19.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
